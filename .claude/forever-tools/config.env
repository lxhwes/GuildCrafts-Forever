# forever-tools settings for GuildCrafts. Parsed as KEY=value, never sourced.
# Prose-level rules (gist workflow, queue format, hard constraints) live in CLAUDE.md.
FT_PROJECT=GuildCrafts
FT_ADDON_DIRS="GuildCrafts"
# Inherited and never edited: embedded libraries and Classic recipe data.
FT_ADDON_EXCLUDE="Libs Data"
# Only the Forever TOC. The five Classic TOCs are never edited.
FT_TOC="GuildCrafts/GuildCrafts_Camelot.toc"
FT_WATCHLIST=".claude/forever-tools/watchlist.txt"
FT_CITED_DOCS="spec CLAUDE.md AGENTS.md docs"
FT_INTERNALS_DOC="spec/migration-forever.md"
FT_QUEUE="docs/ingame-commands.md"
FT_BUILD_LOG="docs/beta-builds.md"
FT_BUCKETS="Professions=/Blizzard_Professions;Chat=/Blizzard_(ChatFrame|DeprecatedChatInfo)/;Guild and communities=/Blizzard_(Communities|GuildControlUI)/"
# GuildCrafts has no toolchain of its own yet; this is LegacyNext's PUC Lua 5.1.5.
FT_LUAC="~/code/legacynext/tools/lua51/bin/luac"
FT_FORBIDDEN_APIS=""
